class RealProxyTestFramework:
    """Framework for testing real residential proxies and stealth techniques."""
    
    def __init__(self, proxy_config: Dict):
        self.proxy_config = proxy_config
        self.session = requests.Session()
        self.setup_proxy_session()
        self.test_results = []
        
    def setup_proxy_session(self):
        """Configure session with proxy authentication."""
        proxy_auth = f"{self.proxy_config['username']}:{self.proxy_config['password']}"
        
        self.session.proxies = {
            'http': f"http://{proxy_auth}@{self.proxy_config['http_proxy'].replace('http://', '')}",
            'https': f"https://{proxy_auth}@{self.proxy_config['https_proxy'].replace('https://', '')}"
        }
        
        # Standard browser headers for initial baseline
        self.session.headers.update({
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
            'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,image/apng,*/*;q=0.8',
            'Accept-Language': 'en-US,en;q=0.9',
            'Accept-Encoding': 'gzip, deflate, br',
            'DNT': '1',
            'Connection': 'keep-alive',
            'Upgrade-Insecure-Requests': '1'
        })
    
    def test_proxy_connectivity(self) -> Dict:
        """Test basic proxy connectivity and IP verification."""
        try:
            response = self.session.get('https://httpbin.org/ip', timeout=30)
            ip_data = response.json()
            
            # Get additional info
            headers_response = self.session.get('https://httpbin.org/headers', timeout=30)
            headers_data = headers_response.json()
            
            return {
                'success': True,
                'proxy_ip': ip_data.get('origin'),
                'response_time': response.elapsed.total_seconds(),
                'status_code': response.status_code,
                'headers_sent': headers_data.get('headers', {}),
                'proxy_location': self.proxy_config['location']
            }
        except Exception as e:
            return {
                'success': False,
                'error': str(e),
                'proxy_location': self.proxy_config['location']
            }
    
    def detect_blocking_vectors(self, url: str) -> Dict:
        """Identify what vectors cause detection/blocking."""
        vectors_tested = {
            'baseline': self.test_baseline_request(url),
            'automation_headers': self.test_automation_headers(url),
            'suspicious_user_agent': self.test_suspicious_user_agent(url),
            'missing_headers': self.test_missing_headers(url),
            'rapid_requests': self.test_rapid_requests(url),
            'tls_fingerprint': self.test_tls_fingerprint_variation(url)
        }
        
        # Analyze which vectors triggered detection
        detection_vectors = []
        for vector, result in vectors_tested.items():
            if result.get('blocked', False) or result.get('challenged', False):
                detection_vectors.append({
                    'vector': vector,
                    'detection_type': result.get('detection_type', 'unknown'),
                    'response_code': result.get('status_code'),
                    'indicators': result.get('detection_indicators', [])
                })
        
        return {
            'url': url,
            'proxy': self.proxy_config['name'],
            'vectors_tested': vectors_tested,
            'detection_vectors': detection_vectors,
            'total_detections': len(detection_vectors)
        }
    
    def test_baseline_request(self, url: str) -> Dict:
        """Test baseline request with standard browser profile."""
        try:
            response = self.session.get(url, timeout=30)
            return self._analyze_response(response, 'baseline')
        except Exception as e:
            return {'error': str(e), 'vector': 'baseline'}
    
    def test_automation_headers(self, url: str) -> Dict:
        """Test with headers that indicate automation."""
        headers = self.session.headers.copy()
        headers.update({
            'X-Automation': 'selenium',
            'X-WebDriver': 'true',
            'User-Agent': 'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/91.0.4472.124 Safari/537.36'
        })
        
        try:
            response = self.session.get(url, headers=headers, timeout=30)
            return self._analyze_response(response, 'automation_headers')
        except Exception as e:
            return {'error': str(e), 'vector': 'automation_headers'}
    
    def test_suspicious_user_agent(self, url: str) -> Dict:
        """Test with obviously suspicious user agent."""
        headers = self.session.headers.copy()
        headers['User-Agent'] = 'Bot/1.0 (Scraping Service)'
        
        try:
            response = self.session.get(url, headers=headers, timeout=30)
            return self._analyze_response(response, 'suspicious_user_agent')
        except Exception as e:
            return {'error': str(e), 'vector': 'suspicious_user_agent'}
    
    def test_missing_headers(self, url: str) -> Dict:
        """Test with minimal headers (missing standard browser headers)."""
        minimal_headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
        }
        
        try:
            response = self.session.get(url, headers=minimal_headers, timeout=30)
            return self._analyze_response(response, 'missing_headers')
        except Exception as e:
            return {'error': str(e), 'vector': 'missing_headers'}
    
    def test_rapid_requests(self, url: str) -> Dict:
        """Test rapid sequential requests to trigger rate limiting."""
        responses = []
        for i in range(5):
            try:
                response = self.session.get(url, timeout=10)
                responses.append(self._analyze_response(response, f'rapid_request_{i}'))
                time.sleep(0.1)  # Very short delay
            except Exception as e:
                responses.append({'error': str(e), 'vector': f'rapid_request_{i}'})
        
        # Check if any requests were blocked/rate limited
        blocked_count = sum(1 for r in responses if r.get('blocked', False) or r.get('status_code') == 429)
        
        return {
            'vector': 'rapid_requests',
            'total_requests': len(responses),
            'blocked_requests': blocked_count,
            'responses': responses,
            'blocked': blocked_count > 0,
            'detection_type': 'rate_limiting' if blocked_count > 0 else 'none'
        }
    
    def test_tls_fingerprint_variation(self, url: str) -> Dict:
        """Test with different TLS configurations."""
        # This would require more advanced TLS fingerprint manipulation
        # For now, test with different SSL contexts
        try:
            import ssl
            context = ssl.create_default_context()
            context.set_ciphers('ECDHE+AESGCM:ECDHE+CHACHA20:DHE+AESGCM:DHE+CHACHA20:!aNULL:!MD5:!DSS')
            
            # This is a simplified test - real TLS fingerprinting would require more sophisticated tools
            response = self.session.get(url, timeout=30)
            return self._analyze_response(response, 'tls_fingerprint')
        except Exception as e:
            return {'error': str(e), 'vector': 'tls_fingerprint'}
    
    def _analyze_response(self, response, vector_type: str) -> Dict:
        """Analyze response for detection indicators."""
        content = response.text.lower()
        headers = response.headers
        
        # Common detection indicators
        detection_indicators = []
        
        # Check for common blocking/challenge indicators
        blocking_patterns = [
            'access denied', 'blocked', 'forbidden', 'captcha', 'challenge',
            'ray id', 'cloudflare', 'security check', 'unusual traffic',
            'automated', 'bot', 'suspicious activity', 'rate limit',
            'too many requests', 'temporarily blocked'
        ]
        
        for pattern in blocking_patterns:
            if pattern in content:
                detection_indicators.append(f"content_contains_{pattern.replace(' ', '_')}")
        
        # Check headers for detection indicators
        suspicious_headers = [
            'cf-ray', 'cf-cache-status', 'x-served-by', 'x-cache',
            'x-rate-limit', 'retry-after', 'x-blocked'
        ]
        
        for header in suspicious_headers:
            if header in [h.lower() for h in headers.keys()]:
                detection_indicators.append(f"header_{header}")
        
        # Determine if request was blocked/challenged
        blocked = (
            response.status_code in [403, 429, 503] or
            any(pattern in content for pattern in ['captcha', 'challenge', 'blocked', 'access denied']) or
            'cf-ray' in [h.lower() for h in headers.keys()]
        )
        
        challenged = (
            response.status_code == 503 or
            any(pattern in content for pattern in ['captcha', 'challenge', 'security check'])
        )
        
        return {
            'vector': vector_type,
            'status_code': response.status_code,
            'response_time': response.elapsed.total_seconds(),
            'content_length': len(content),
            'detection_indicators': detection_indicators,
            'blocked': blocked,
            'challenged': challenged,
            'detection_type': self._classify_detection_type(response.status_code, content, headers)
        }
    
    def _classify_detection_type(self, status_code: int, content: str, headers) -> str:
        """Classify the type of detection/blocking."""
        content_lower = content.lower()
        
        if status_code == 403:
            if 'cloudflare' in content_lower:
                return 'cloudflare_block'
            elif 'access denied' in content_lower:
                return 'access_denied'
            else:
                return 'forbidden'
        elif status_code == 429:
            return 'rate_limiting'
        elif status_code == 503:
            if 'captcha' in content_lower or 'challenge' in content_lower:
                return 'captcha_challenge'
            else:
                return 'service_unavailable'
        elif 'captcha' in content_lower:
            return 'captcha_challenge'
        elif any(pattern in content_lower for pattern in ['bot', 'automated', 'suspicious']):
            return 'bot_detection'
        else:
            return 'none'
    
    def apply_stealth_masking(self) -> None:
        """Apply stealth techniques to mask detection vectors."""
        # Update headers with better browser simulation
        self.session.headers.update({
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
            'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,image/apng,*/*;q=0.8',
            'Accept-Language': 'en-US,en;q=0.9',
            'Accept-Encoding': 'gzip, deflate, br',
            'Cache-Control': 'no-cache',
            'Pragma': 'no-cache',
            'Sec-Ch-Ua': '"Not_A Brand";v="8", "Chromium";v="120", "Google Chrome";v="120"',
            'Sec-Ch-Ua-Mobile': '?0',
            'Sec-Ch-Ua-Platform': '"Windows"',
            'Sec-Fetch-Dest': 'document',
            'Sec-Fetch-Mode': 'navigate',
            'Sec-Fetch-Site': 'none',
            'Sec-Fetch-User': '?1',
            'Upgrade-Insecure-Requests': '1'
        })
        
        # Remove any automation-indicating headers
        automation_headers = ['X-Automation', 'X-WebDriver', 'X-Selenium']
        for header in automation_headers:
            self.session.headers.pop(header, None)
    
    def test_stealth_effectiveness(self, url: str) -> Dict:
        """Test effectiveness of stealth masking against previous detections."""
        # First test without stealth
        baseline_result = self.test_baseline_request(url)
        
        # Apply stealth masking
        self.apply_stealth_masking()
        
        # Test with stealth applied
        stealth_result = self.test_baseline_request(url)
        
        # Add realistic delays between requests
        time.sleep(2)
        
        # Compare effectiveness
        baseline_blocked = baseline_result.get('blocked', False)
        stealth_blocked = stealth_result.get('blocked', False)
        
        improvement = baseline_blocked and not stealth_blocked
        
        return {
            'url': url,
            'proxy': self.proxy_config['name'],
            'baseline_blocked': baseline_blocked,
            'stealth_blocked': stealth_blocked,
            'improvement': improvement,
            'baseline_indicators': baseline_result.get('detection_indicators', []),
            'stealth_indicators': stealth_result.get('detection_indicators', []),
            'stealth_effectiveness': 'effective' if improvement else 'ineffective'
        }


@pytest.mark.asyncio
@pytest.mark.real_proxy
class TestRealResidentialProxyValidation:
    """Test suite for real residential proxy validation and stealth techniques."""
    
    def setup_method(self):
        """Set up test environment."""
        self.test_frameworks = {}
        for proxy_name, proxy_config in REAL_PROXIES.items():
            self.test_frameworks[proxy_name] = RealProxyTestFramework(proxy_config)
    
    @pytest.mark.parametrize("proxy_name", list(REAL_PROXIES.keys()))
    async def test_proxy_connectivity(self, proxy_name):
        """Test basic connectivity and IP verification for each proxy."""
        framework = self.test_frameworks[proxy_name]
        result = framework.test_proxy_connectivity()
        
        # Verify connectivity
        assert result['success'], f"Proxy {proxy_name} connectivity failed: {result.get('error', 'Unknown error')}"
        assert result['proxy_ip'] is not None, f"Could not determine IP for proxy {proxy_name}"
        assert result['response_time'] < 30, f"Proxy {proxy_name} response time too slow: {result['response_time']}s"
        
        # Log proxy details
        print(f"\n=== Proxy {proxy_name} Details ===")
        print(f"IP: {result['proxy_ip']}")
        print(f"Location: {result['proxy_location']}")
        print(f"Response Time: {result['response_time']:.2f}s")
    
    @pytest.mark.parametrize("proxy_name", list(REAL_PROXIES.keys()))
    async def test_cloudflare_detection_vectors(self, proxy_name):
        """Test detection vector identification against Cloudflare-protected sites."""
        framework = self.test_frameworks[proxy_name]
        
        results = []
        for url in TARGET_WEBSITES['cloudflare_protected'][:2]:  # Test first 2 URLs
            result = framework.detect_blocking_vectors(url)
            results.append(result)
            
            # Add delay between requests
            await asyncio.sleep(3)
        
        # Analyze results
        total_detections = sum(r['total_detections'] for r in results)
        
        # At least one site should provide useful detection data
        assert len(results) > 0, f"No detection tests completed for proxy {proxy_name}"
        
        # Log detection vectors found
        print(f"\n=== Detection Vectors for {proxy_name} ===")
        for result in results:
            print(f"URL: {result['url']}")
            print(f"Detections: {result['total_detections']}")
            for vector in result['detection_vectors']:
                print(f"  - {vector['vector']}: {vector['detection_type']}")
    
    @pytest.mark.parametrize("proxy_name", list(REAL_PROXIES.keys()))  
    async def test_bot_detection_sites(self, proxy_name):
        """Test against known bot detection services."""
        framework = self.test_frameworks[proxy_name]
        
        # Test the most reliable bot detection site
        url = "https://httpbin.org/headers"  # Use httpbin as it's more reliable
        
        result = framework.detect_blocking_vectors(url)
        
        # Should get some response (even if not detected)
        assert 'vectors_tested' in result, f"Failed to test vectors for {proxy_name}"
        
        baseline = result['vectors_tested'].get('baseline')
        if baseline and not baseline.get('error'):
            assert baseline.get('status_code') in [200, 403, 429, 503], f"Unexpected status code: {baseline.get('status_code')}"
        
        print(f"\n=== Bot Detection Test for {proxy_name} ===")
        print(f"URL: {result['url']}")
        print(f"Total Detection Vectors: {result['total_detections']}")
    
    @pytest.mark.parametrize("proxy_name", list(REAL_PROXIES.keys()))
    async def test_stealth_masking_effectiveness(self, proxy_name):
        """Test effectiveness of stealth masking techniques."""
        framework = self.test_frameworks[proxy_name]
        
        # Test stealth effectiveness on a reliable endpoint
        url = "https://httpbin.org/headers"
        
        result = framework.test_stealth_effectiveness(url)
        
        # Verify test completed
        assert 'baseline_blocked' in result, f"Stealth test failed to complete for {proxy_name}"
        assert 'stealth_blocked' in result, f"Stealth test failed to complete for {proxy_name}"
        
        # Log stealth effectiveness
        print(f"\n=== Stealth Effectiveness for {proxy_name} ===")
        print(f"URL: {result['url']}")
        print(f"Baseline Blocked: {result['baseline_blocked']}")
        print(f"Stealth Blocked: {result['stealth_blocked']}")
        print(f"Improvement: {result['improvement']}")
        print(f"Effectiveness: {result['stealth_effectiveness']}")
        
        # If baseline was blocked, stealth should show improvement
        if result['baseline_blocked']:
            # Allow for some cases where stealth doesn't help (depends on detection method)
            # but overall stealth techniques should provide some benefit
            pass  # This is informational for now
    
    async def test_multi_proxy_consistency(self):
        """Test consistency of results across different proxy locations."""
        url = "https://httpbin.org/ip"
        
        results = {}
        for proxy_name in REAL_PROXIES.keys():
            framework = self.test_frameworks[proxy_name]
            
            try:
                connectivity = framework.test_proxy_connectivity()
                if connectivity['success']:
                    results[proxy_name] = {
                        'ip': connectivity['proxy_ip'],
                        'response_time': connectivity['response_time'],
                        'location': connectivity['proxy_location']
                    }
                    await asyncio.sleep(2)  # Delay between proxies
            except Exception as e:
                results[proxy_name] = {'error': str(e)}
        
        # Should have results from at least one proxy
        successful_proxies = [name for name, result in results.items() if 'error' not in result]
        assert len(successful_proxies) > 0, "No proxies were successful"
        
        # Verify different IPs (indicating different proxy locations)
        ips = [result['ip'] for result in results.values() if 'ip' in result]
        unique_ips = set(ips)
        
        assert len(unique_ips) > 1 or len(successful_proxies) == 1, f"Expected different IPs from different proxies, got: {ips}"
        
        print(f"\n=== Multi-Proxy Consistency Results ===")
        for proxy_name, result in results.items():
            if 'error' not in result:
                print(f"{proxy_name}: {result['ip']} ({result['location']}) - {result['response_time']:.2f}s")
            else:
                print(f"{proxy_name}: ERROR - {result['error']}")
    
    async def test_comprehensive_stealth_validation(self):
        """Comprehensive validation of stealth techniques across all proxies and sites."""
        comprehensive_results = {
            'proxy_results': {},
            'overall_effectiveness': {},
            'detection_patterns': [],
            'stealth_recommendations': []
        }
        
        for proxy_name in REAL_PROXIES.keys():
            framework = self.test_frameworks[proxy_name]
            proxy_results = {'sites': {}, 'summary': {}}
            
            # Test a subset of sites to avoid overwhelming the proxies
            test_urls = [
                "https://httpbin.org/headers",
                "https://httpbin.org/ip", 
                "https://httpbin.org/delay/1"
            ]
            
            for url in test_urls:
                try:
                    stealth_result = framework.test_stealth_effectiveness(url)
                    proxy_results['sites'][url] = stealth_result
                    await asyncio.sleep(2)  # Respectful delay
                except Exception as e:
                    proxy_results['sites'][url] = {'error': str(e)}
            
            # Analyze proxy summary
            successful_tests = [r for r in proxy_results['sites'].values() if 'error' not in r]
            if successful_tests:
                improvements = sum(1 for r in successful_tests if r.get('improvement', False))
                proxy_results['summary'] = {
                    'total_tests': len(successful_tests),
                    'improvements': improvements,
                    'effectiveness_rate': improvements / len(successful_tests) if successful_tests else 0
                }
            
            comprehensive_results['proxy_results'][proxy_name] = proxy_results
        
        # Overall analysis
        all_successful_tests = []
        for proxy_results in comprehensive_results['proxy_results'].values():
            all_successful_tests.extend([
                r for r in proxy_results['sites'].values() 
                if 'error' not in r and 'improvement' in r
            ])
        
        if all_successful_tests:
            total_improvements = sum(1 for r in all_successful_tests if r['improvement'])
            overall_effectiveness = total_improvements / len(all_successful_tests)
            
            comprehensive_results['overall_effectiveness'] = {
                'total_tests': len(all_successful_tests),
                'total_improvements': total_improvements,
                'effectiveness_rate': overall_effectiveness
            }
        
        # Verify we got some useful data
        assert len(all_successful_tests) > 0, "No successful stealth tests completed"
        
        print(f"\n=== Comprehensive Stealth Validation Results ===")
        print(f"Total Successful Tests: {len(all_successful_tests)}")
        if 'effectiveness_rate' in comprehensive_results['overall_effectiveness']:
            print(f"Overall Effectiveness Rate: {comprehensive_results['overall_effectiveness']['effectiveness_rate']:.2%}")
        
        # This test is primarily informational - real-world results will vary
        # The main goal is to validate the testing framework works
        
    @pytest.mark.parametrize("proxy_name", list(REAL_PROXIES.keys()))
    async def test_challenging_sites_detection(self, proxy_name):
        """Test against challenging real-world sites with sophisticated detection."""
        framework = self.test_frameworks[proxy_name]
        
        # Test against different categories of challenging sites
        test_categories = [
            #('e_commerce', TARGET_WEBSITES['e_commerce'][:2]),  # Amazon, eBay
            #('social_media', TARGET_WEBSITES['social_media'][:2]),  # Instagram, Facebook  
            ('streaming', TARGET_WEBSITES['streaming'][:1]),  # Netflix
            #('financial', TARGET_WEBSITES['financial'][:1]),  # PayPal
        ]
        
        detection_summary = {
            'proxy': proxy_name,
            'categories_tested': {},
            'total_detections': 0,
            'detection_types': {},
            'challenging_sites': []
        }
        
        print(f"\n=== Testing Challenging Sites for {proxy_name} ===")
        
        for category, urls in test_categories:
            category_results = []
            
            for url in urls:
                try:
                    print(f"Testing {url}...")
                    result = framework.detect_blocking_vectors(url)
                    category_results.append(result)
                    
                    # Log immediate results
                    if result['total_detections'] > 0:
                        print(f"  🚫 DETECTED: {result['total_detections']} vectors")
                        for vector in result['detection_vectors']:
                            print(f"    - {vector['vector']}: {vector['detection_type']}")
                        detection_summary['challenging_sites'].append(url)
                    else:
                        print(f"  ✅ CLEAN: No detection vectors triggered")
                    
                    # Respectful delay between challenging sites
                    await asyncio.sleep(5)
                    
                except Exception as e:
                    print(f"  ❌ ERROR: {str(e)}")
                    category_results.append({'error': str(e), 'url': url})
            
            # Analyze category results
            successful_tests = [r for r in category_results if 'error' not in r]
            total_detections = sum(r.get('total_detections', 0) for r in successful_tests)
            
            detection_summary['categories_tested'][category] = {
                'sites_tested': len(urls),
                'successful_tests': len(successful_tests),
                'total_detections': total_detections,
                'detection_rate': total_detections / len(successful_tests) if successful_tests else 0
            }
            
            detection_summary['total_detections'] += total_detections
            
            # Count detection types
            for result in successful_tests:
                for vector in result.get('detection_vectors', []):
                    detection_type = vector.get('detection_type', 'unknown')
                    detection_summary['detection_types'][detection_type] = detection_summary['detection_types'].get(detection_type, 0) + 1
        
        # Summary report
        print(f"\n=== {proxy_name} Challenge Summary ===")
        print(f"Total Detection Vectors: {detection_summary['total_detections']}")
        print(f"Challenging Sites: {len(detection_summary['challenging_sites'])}")
        print(f"Detection Types: {detection_summary['detection_types']}")
        
        # Test passes if we get responses (even if detected)
        assert len(detection_summary['categories_tested']) > 0, f"No categories tested for {proxy_name}"
        
        # The goal is to identify detection patterns, not necessarily avoid all detection
        # Some detection is expected against these sophisticated systems
    
    @pytest.mark.parametrize("proxy_name", list(REAL_PROXIES.keys()))
    async def test_advanced_stealth_against_real_sites(self, proxy_name):
        """Test advanced stealth techniques against real challenging sites."""
        framework = self.test_frameworks[proxy_name]
        
        # Select most challenging sites for stealth testing
        challenging_urls = [
            "https://www.amazon.com/",
            "https://www.cloudflare.com/",
            "https://bot.sannysoft.com/"
        ]
        
        stealth_results = []
        
        print(f"\n=== Advanced Stealth Testing for {proxy_name} ===")
        
        for url in challenging_urls:
            try:
                print(f"Testing stealth effectiveness on {url}...")
                
                # Test baseline detection
                baseline_result = framework.test_baseline_request(url)
                await asyncio.sleep(3)
                
                # Apply stealth masking 
                framework.apply_stealth_masking()
                await asyncio.sleep(2)
                
                # Test with stealth
                stealth_result = framework.test_baseline_request(url)
                await asyncio.sleep(3)
                
                # Compare results
                baseline_blocked = baseline_result.get('blocked', False)
                stealth_blocked = stealth_result.get('blocked', False)
                baseline_indicators = len(baseline_result.get('detection_indicators', []))
                stealth_indicators = len(stealth_result.get('detection_indicators', []))
                
                improvement = baseline_blocked and not stealth_blocked
                indicator_reduction = baseline_indicators > stealth_indicators
                
                result_summary = {
                    'url': url,
                    'baseline_blocked': baseline_blocked,
                    'stealth_blocked': stealth_blocked,
                    'baseline_indicators': baseline_indicators,
                    'stealth_indicators': stealth_indicators,
                    'improvement': improvement,
                    'indicator_reduction': indicator_reduction,
                    'baseline_status': baseline_result.get('status_code'),
                    'stealth_status': stealth_result.get('status_code')
                }
                
                stealth_results.append(result_summary)
                
                # Log results
                print(f"  Baseline: {'🚫' if baseline_blocked else '✅'} ({baseline_result.get('status_code')} - {baseline_indicators} indicators)")
                print(f"  Stealth:  {'🚫' if stealth_blocked else '✅'} ({stealth_result.get('status_code')} - {stealth_indicators} indicators)")
                print(f"  Improvement: {'🎯' if improvement else '❌'} | Indicator Reduction: {'📉' if indicator_reduction else '📈'}")
                
                # Longer delay between challenging sites
                await asyncio.sleep(8)
                
            except Exception as e:
                print(f"  ❌ ERROR testing {url}: {str(e)}")
                stealth_results.append({'url': url, 'error': str(e)})
        
        # Analyze overall stealth effectiveness
        successful_tests = [r for r in stealth_results if 'error' not in r]
        if successful_tests:
            improvements = sum(1 for r in successful_tests if r.get('improvement', False))
            indicator_reductions = sum(1 for r in successful_tests if r.get('indicator_reduction', False))
            
            effectiveness_rate = improvements / len(successful_tests)
            indicator_reduction_rate = indicator_reductions / len(successful_tests)
            
            print(f"\n=== {proxy_name} Stealth Summary ===")
            print(f"Sites Tested: {len(successful_tests)}")
            print(f"Blocking Improvements: {improvements}/{len(successful_tests)} ({effectiveness_rate:.1%})")
            print(f"Indicator Reductions: {indicator_reductions}/{len(successful_tests)} ({indicator_reduction_rate:.1%})")
        
        # Test passes if we completed testing
        assert len(stealth_results) > 0, f"No stealth tests completed for {proxy_name}"
    
