nabled,\n    doNotTrack: navigator.doNotTrack,\n    timestamp: new Date().toISOString()\n  };\n  \n  // Send fingerprint data\n  fetch('/api/fingerprint/collect', {\n    method: 'POST',\n    headers: {'Content-Type': 'application/json'},\n    body: JSON.stringify(comprehensiveFingerprint)\n  }).catch(function(e) {\n    console.log('Fingerprint collection failed:', e);\n  });\n  \n  // Set tracking cookie\n  document.cookie = 'advanced_fp=' + btoa(JSON.stringify({id: 'fp_' + Date.now(), risk: 'very_high', automated: true})) + '; SameSite=None; Secure';\n  \n})();"
